{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "photocraft": {
        "type": "local",
        "command": [
          "{env:HOME}/Applications/squashfs-root/usr/bin/photocraft-cli",
          "mcp",
          "--automation-read-root",
          "{env:HOME}",
          "--automation-write-root",
          "{env:HOME}"
        ]
      }
    }
  }
}
