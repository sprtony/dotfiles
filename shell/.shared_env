# PATHS compartidos entre Bash y Zsh (Omarchy y macOS)
export EDITOR="nvim"
export TERM="xterm-256color"

# Rust / Cargo
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
export PATH="$HOME/.cargo/bin:$PATH"

# Composer (Linux y macOS)
[ -d "$HOME/.config/composer/vendor/bin" ] && export PATH="$HOME/.config/composer/vendor/bin:$PATH"
[ -d "$HOME/.composer/vendor/bin" ] && export PATH="$HOME/.composer/vendor/bin:$PATH"

# Bob (Neovim version manager)
export PATH="$HOME/.local/share/bob/nvim-bin:$PATH"

# pnpm (único gestor Node global)
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# Brew (Linuxbrew y Homebrew macOS)
if [ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -x "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x "/usr/local/bin/brew" ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# OpenCode
export PATH="$HOME/.opencode/bin:$PATH"

# Override local de OpenCode (solo existe en Omarchy)
if [ -f "$HOME/.config/opencode/opencode.omarchy.json" ]; then
  export OPENCODE_CONFIG="$HOME/.config/opencode/opencode.omarchy.json"
fi

# Local bin
export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:$PATH"

# Node lo gestiona mise (ver .zshrc y mise config.toml). NVM no se carga aquí
# para evitar que compitan por el mismo binario `node`.

# Secretos globales (fuera de dotfiles, permisos 600)
if [ -f "$HOME/.config/secrets/keys.env" ]; then
  set -a
  . "$HOME/.config/secrets/keys.env"
  set +a
fi
